{
  "name": "code-snap",
  "version": "0.1.0",
  "description": "跨平台代码片段管理工具",
  "author": "CodeSnap Team",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "electron:dev": "vite --mode development & electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:linux": "vite build && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "copy-electron": "xcopy /E /I /Y electron dist\\electron",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "better-sqlite3": "^9.4.3",
    "clipboardy": "^4.0.0",
    "dayjs": "^1.11.10",
    "electron-store": "^8.1.0",
    "element-plus": "^2.5.3",
    "lodash": "^4.17.21",
    "monaco-editor": "^0.45.0",
    "pinia": "^2.1.7",
    "prettier": "^3.2.4",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "asar": "^3.2.0",
    "electron": "28.2.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "prebuild-install": "^7.1.3",
    "sass": "^1.101.0",
    "terser": "^5.48.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.codesnap.app",
    "productName": "CodeSnap",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "lzma-native",
      "vue-demi"
    ]
  }
}